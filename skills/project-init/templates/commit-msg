#!/bin/sh
git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 && exit 0
subj=$(sed -n -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' -e 's/[[:space:]]*$//' -e 'p' -e 'q' "$1")
case "$subj" in "Merge "*|'Revert "'*) exit 0 ;; esac
[ $(printf '%s' "$subj" | wc -m) -le 72 ] || { echo "commit-msg: subject > 72 chars" >&2; exit 1; }
printf '%s\n' "$subj" | LC_ALL=C grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?!?: [^A-Z[:space:]]' && [ "${subj%.}" = "$subj" ] && exit 0
echo "commit-msg: invalid Conventional Commits subject: $subj" >&2
exit 1
