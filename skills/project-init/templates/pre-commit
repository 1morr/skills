#!/bin/sh
# 每次 commit 前執行的零依賴快檢查：攔截合併衝突標記、私鑰標頭與 >2MB 大檔案。
# M0 的第一張票可將幾秒內跑完的 format / lint 接在本檔結尾。
set -eu
MAX_BYTES=2097152
files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$files" ] || exit 0

printf '%s\n' "$files" | while IFS= read -r file; do
  [ -n "$file" ] || continue
  size=$(git cat-file -s ":$file" 2>/dev/null || echo 0)
  if [ "$size" -gt "$MAX_BYTES" ]; then
    echo "pre-commit: $file exceeds 2MB ($size bytes)" >&2
    exit 1
  fi
  if git show ":$file" 2>/dev/null | LC_ALL=C grep -Eq '^<{7}([[:space:]]|$)'; then
    echo "pre-commit: unresolved merge conflict marker in $file" >&2
    exit 1
  fi
  if git show ":$file" 2>/dev/null | LC_ALL=C grep -Eq '^-----BEGIN ([A-Z0-9 ]+ )?PRIVATE KEY-----'; then
    echo "pre-commit: private key header detected in $file" >&2
    exit 1
  fi
done || exit 1
